default_platform(:android)

platform :android do

  # ─── shared release helper ──────────────────────────────────────────────────
  # Builds a Release AAB and uploads it to the given Play track.
  #
  # Options (all optional):
  #   track:       Play track to upload to ("internal" | "alpha" | "production")
  #   skip_bump:   true  → don't touch version.properties at all (rebuild same version)
  #   code_only:   true  → bump versionCode only, keep versionName unchanged
  #   promote:     <int> → promote an ALREADY-UPLOADED versionCode to `track`
  #                        (no rebuild, no upload of a new AAB, no bump — just moves
  #                         the existing release; use this to send an existing build
  #                         to a higher track without changing its version)
  #   skip_upload: true  → build (and bump, unless skipped) but don't upload to Play
  #   skip_push:   true  → commit the version bump locally but don't push to git
  private_lane :release_to_play do |options|
    track       = options[:track]
    skip_bump   = options.fetch(:skip_bump, false)
    code_only   = options.fetch(:code_only, false)
    skip_upload = options.fetch(:skip_upload, false)
    skip_push   = options.fetch(:skip_push, false)
    promote     = options[:promote]

    # ── Promote mode: move an already-uploaded build to `track`. No rebuild / no bump.
    #    Play rejects re-uploading an AAB whose versionCode already exists, so this is
    #    the only way to push an existing build to another track without a new version.
    if promote
      upload_to_play_store(
        track: track,
        version_code: promote.to_i,
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
      next
    end

    # ── Translate bump options into Gradle properties consumed by the
    #    `incrementVersionCode` task in app/build.gradle.kts.
    gradle_flags = ["--no-configuration-cache"]
    gradle_flags << "-PskipVersionBump"     if skip_bump
    gradle_flags << "-PskipVersionNameBump" if code_only && !skip_bump

    # Build release APK for local/device testing (assembleRelease never bumps).
    gradle(
      task: "assemble",
      build_type: "Release",
      flags: gradle_flags.join(" "),
      print_command: false
    )

    # Build release AAB for Play upload (bundleRelease triggers the bump unless skipped).
    gradle(
      task: "bundle",
      build_type: "Release",
      flags: gradle_flags.join(" "),
      print_command: false
    )

    unless skip_upload
      upload_to_play_store(
        track: track,
        aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
        mapping: lane_context[SharedValues::GRADLE_MAPPING_TXT_OUTPUT_PATH],
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end

    # ── Commit the version bump only when something actually changed on disk.
    unless skip_bump
      git_commit(
        path: "version.properties",
        message: "chore: bump versionCode [fastlane]"
      )
      push_to_git_remote unless skip_push
    end
  end

  # ─── fastlane internal ───────────────────────────────────────────────────────
  # Uploads a Release AAB to the Play **Internal testing** track.
  desc "Build & upload a Release AAB to the Internal testing track"
  desc "Options: skip_bump:true | code_only:true | promote:<code> | skip_upload:true | skip_push:true"
  lane :internal do |options|
    release_to_play(options.merge(track: "internal"))
  end

  # ─── fastlane closed ─────────────────────────────────────────────────────────
  # Uploads a Release AAB to Closed testing (Alpha).
  desc "Build & upload a Release AAB to Closed testing (Alpha)"
  desc "Options: skip_bump:true | code_only:true | promote:<code> | skip_upload:true | skip_push:true"
  lane :closed do |options|
    release_to_play(options.merge(track: "alpha"))
  end

  # ─── fastlane production ─────────────────────────────────────────────────────
  # Uploads a Release AAB to Production.
  desc "Build & upload a Release AAB to Production"
  desc "Options: skip_bump:true | code_only:true | promote:<code> | skip_upload:true | skip_push:true"
  lane :production do |options|
    release_to_play(options.merge(track: "production"))
  end

  # ─── fastlane internal_share ─────────────────────────────────────────────────
  # Internal App Sharing: builds a Release APK and uploads it for a shareable
  # install link. Never bumps the version (assembleRelease has no bump hook).
  desc "Build a Release APK and upload to Internal App Sharing (APK only, no bump)"
  lane :internal_share do
    gradle(
      task: "assemble",
      build_type: "Release",
      flags: "--no-configuration-cache",
      print_command: false
    )

    upload_to_play_store_internal_app_sharing(
      apk: "app/build/outputs/apk/release/app-release.apk"
    )
  end

  # ─── fastlane retry_production_upload ────────────────────────────────────────
  # Re-upload existing release artifacts to production without rebuilding/bumping.
  desc "Retry Play upload for existing release artifacts without rebuilding/bumping"
  lane :retry_production_upload do
    upload_to_play_store(
      track: "production",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      mapping: "app/build/outputs/mapping/release/mapping.txt",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # ─── fastlane test ──────────────────────────────────────────────────────────
  desc "Run unit tests"
  lane :test do
    gradle(task: "test")
  end

end
